# Optional: LLM used to explain which dependency path causes the risk.
# Without a key the engine uses a deterministic explanation template.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: own RPC endpoints (defaults to public endpoints)
# RPC_URL=https://...           # Ethereum mainnet
# RPC_URL_8453=https://...      # Base

# Monitoring (optional)
# HISTORY_DB=data/history.sqlite3   # run history; default backend/data/history.sqlite3
# MONITOR_INTERVAL_S=3600           # initial schedule of the API monitor; change it later in the UI (off by default)
# WATCHLIST=watchlist.json          # used until investments are selected in the UI; default: the presets
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...   # posts verdict flips and break-even crossings
